# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# D18/M17 bug #7: real release-signing keystore + credentials — generated
# locally per docs/RELEASE.md, NEVER committed. `key.properties.example` in
# this same `android/` directory is the (secret-free) template.
/android/key.properties
/android/*.jks
/android/*.keystore
/android/app/*.jks
/android/app/*.keystore

# Widget Preview related
.widget_preview/

# Isar native core binary, auto-downloaded by
# Isar.initializeIsarCore(download: true) for host-platform `flutter test`
# runs (see test/core/database/*_test.dart) — platform-specific, not source.
libisar.so
libisar.dylib
isar.dll
